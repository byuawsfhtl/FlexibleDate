[run]
source = .
omit =
    FlexibleDateTS/*
    tests/*
    **/test_*.py
    **/__init__.py
    _version.py
    setup.py

[report]
exclude_lines =
    pragma: no cover
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

[html]
directory = htmlcov

